<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);._*</DefaultItemExcludes>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Xbox build marker -->
    <DefineConstants>$(DefineConstants);XBOX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ryujinx.Host.Xbox\Ryujinx.Host.Xbox.csproj" />
    <ProjectReference Include="..\Ryujinx.Graphics.Xbox\Ryujinx.Graphics.Xbox.csproj" />
    <ProjectReference Include="..\Ryujinx.Common\Ryujinx.Common.csproj" />
    <ProjectReference Include="..\Ryujinx.HLE\Ryujinx.HLE.csproj" />
  </ItemGroup>

  <!-- Copy Vulkan ICD manifest alongside the output -->
  <ItemGroup>
    <None Include="..\..\build\xbox\xbox_vulkan_icd.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
